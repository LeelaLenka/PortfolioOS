# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Neon: Dashboard -> your project -> Connect -> copy the connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Any long random text, at least 32 characters
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Frontend URL(s) allowed to call the API, comma-separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run db:seed` to create the owner account
OWNER_EMAIL=leelakrishnalenka@gmail.com
OWNER_SLUG=bharat
