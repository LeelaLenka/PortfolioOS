# Backend Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=5000

# PostgreSQL (Neon in production)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_os?schema=public"

# JWT — use a long random string in production (openssl rand -base64 64)
JWT_SECRET=change-me-use-openssl-rand-base64-64-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Cloudinary (Phase: file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173
